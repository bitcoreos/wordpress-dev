{
  "version": 2,
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "settings": {
    "color": {
      "palette": [
        { "slug": "primary", "color": "#6366f1", "name": "Primary (Indigo)" },
        { "slug": "success", "color": "#10b981", "name": "Success (Emerald)" },
        { "slug": "warning", "color": "#f59e0b", "name": "Warning (Amber)" },
        { "slug": "error", "color": "#ef4444", "name": "Error (Red)" },
        { "slug": "surface", "color": "#1e1e2e", "name": "Surface (Dark)" },
        { "slug": "border", "color": "#313244", "name": "Border" },
        { "slug": "text-primary", "color": "#e4e4e7", "name": "Text Primary" },
        { "slug": "text-secondary", "color": "#a1a1aa", "name": "Text Secondary" },
        { "slug": "accent", "color": "#8b5cf6", "name": "Accent (Violet)" }
      ],
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "duotone": [
        {
          "colors": ["#1e1e2e", "#6366f1"],
          "slug": "primary-dark",
          "name": "Primary Dark"
        },
        {
          "colors": ["#1e1e2e", "#8b5cf6"],
          "slug": "accent-dark",
          "name": "Accent Dark"
        }
      ],
      "gradients": [
        { "slug": "primary-accent", "gradient": "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)", "name": "Primary to Accent" },
        { "slug": "surface-gradient", "gradient": "linear-gradient(180deg, #1e1e2e 0%, #11111b 100%)", "name": "Surface Gradient" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, sans-serif", "slug": "system", "name": "System Font" },
        { "fontFamily": "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace", "slug": "mono", "name": "Monospace" }
      ],
      "fontSizes": [
        { "size": "0.75rem", "slug": "xs", "name": "Extra Small" },
        { "size": "0.875rem", "slug": "sm", "name": "Small" },
        { "size": "1rem", "slug": "base", "name": "Base" },
        { "size": "1.125rem", "slug": "lg", "name": "Large" },
        { "size": "1.25rem", "slug": "xl", "name": "Extra Large" },
        { "size": "1.5rem", "slug": "2xl", "name": "2X Large" },
        { "size": "2rem", "slug": "3xl", "name": "3X Large" }
      ],
      "lineHeight": true,
      "customFontSize": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "spacingSizes": [
        { "size": "0.25rem", "slug": "1", "name": "1" },
        { "size": "0.5rem", "slug": "2", "name": "2" },
        { "size": "0.75rem", "slug": "3", "name": "3" },
        { "size": "1rem", "slug": "4", "name": "4" },
        { "size": "1.5rem", "slug": "5", "name": "5" },
        { "size": "2rem", "slug": "6", "name": "6" },
        { "size": "3rem", "slug": "7", "name": "7" },
        { "size": "4rem", "slug": "8", "name": "8" }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "presets": [
        { "slug": "sm", "shadow": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "name": "Small" },
        { "slug": "md", "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)", "name": "Medium" },
        { "slug": "lg", "shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)", "name": "Large" },
        { "slug": "glow", "shadow": "0 0 20px rgba(99, 102, 241, 0.3)", "name": "Primary Glow" },
        { "slug": "accent-glow", "shadow": "0 0 20px rgba(139, 92, 246, 0.3)", "name": "Accent Glow" }
      ]
    },
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1536px"
    },
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--text-primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--5)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--text-primary)"
        },
        "typography": {
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "border": {
          "radius": "0.5rem"
        },
        "typography": {
          "fontWeight": "500"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent)"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--text-secondary)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--sm)"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0.5rem"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.5rem",
            "bottom": "0.75rem",
            "left": "1.5rem"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--base)"
        }
      },
      "core/post-title": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--3xl)",
          "fontWeight": "700"
        }
      },
      "core/card": {
        "border": {
          "radius": "0.75rem"
        },
        "spacing": {
          "padding": "var(--wp--preset--spacing--5)"
        }
      }
    }
  },
  "customTemplates": [
    { "name": "dashboard", "title": "Dashboard", "postTypes": ["page"] },
    { "name": "feed", "title": "Feed", "postTypes": ["page"] },
    { "name": "chat", "title": "Chat Interface", "postTypes": ["page"] },
    { "name": "intent", "title": "Intent Form", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "sidebar", "title": "Sidebar", "area": "uncategorized" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
