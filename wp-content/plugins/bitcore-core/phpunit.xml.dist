<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.0/phpunit.xsd"
    bootstrap="tests/bootstrap-standalone.php"
    colors="false"
    cacheDirectory=".phpunit.cache"
>
    <!--
        Engine split. This config is the WordPress-free engine (PHPUnit 10+).
        WordPress-dependent suites live in config/phpunit.xml.dist under PHPUnit 9.
        Explicit file lists are used because 29 of the 38 *Test.php files are
        self-executing scripts (18 with a file-scope exit) that PHPUnit cannot
        collect; they are executed by tests/run-standalone.sh instead.
    -->
    <testsuites>
        <testsuite name="Standalone-Unit">
            <file>tests/container/ContainerTest.php</file>
            <file>tests/connectors/AbstractConnectorTest.php</file>
            <file>tests/rest/RestSchemaTest.php</file>
        </testsuite>
    </testsuites>

    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory suffix=".php">classes/</directory>
            <directory suffix=".php">infrastructure/</directory>
        </include>
    </source>
</phpunit>
