{
    "name": "bitcore/core",
    "description": "BITCORE Core - SaaS Infrastructure for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "BITCORE",
            "email": "core@bitcoreos.org"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "firebase/php-jwt": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.8",
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "yoast/phpunit-polyfills": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "BITCORE\\": "classes/",
            "BITCORE\\Infrastructure\\": "infrastructure/",
            "BITCORE\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "analyze": "phpstan analyse --configuration=phpstan.neon.dist"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
