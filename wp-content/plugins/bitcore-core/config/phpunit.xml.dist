<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
    bootstrap="../tests/bootstrap.php"
    backupGlobals="false"
    colors="false"
    cacheDirectory="../.phpunit.cache-wp"
>
    <!--
        WordPress engine (PHPUnit 9.6).
        The WordPress 7.1.5 test library calls
        PHPUnit\Util\Test::parseTestMethodAnnotations(), which exists in PHPUnit 9
        and was removed in PHPUnit 10, so WP_UnitTestCase suites cannot run on the
        PHPUnit 10 engine used by phpunit.xml.dist.

        Only the six real WP_UnitTestCase classes are listed. The remaining 32
        *Test.php files declare no extending class and are self-executing scripts
        (18 call exit() at file scope); PHPUnit cannot collect them, so they run
        through tests/run-standalone.sh.

        WP_TESTS_PHPUNIT_POLYFILLS_PATH is resolved absolutely in
        tests/bootstrap.php; no relative path is declared here.
    -->
    <testsuites>
        <testsuite name="WordPress">
            <file>../tests/auth/AuthManagerTest.php</file>
            <file>../tests/cache/ManagerTest.php</file>
            <file>../tests/queue/WorkerTest.php</file>
            <file>../tests/webhooks/ManagerTest.php</file>
            <file>../tests/multitenancy/TenantTest.php</file>
            <file>../tests/Knowledge/KnowledgeModelTest.php</file>
        </testsuite>
    </testsuites>
</phpunit>
